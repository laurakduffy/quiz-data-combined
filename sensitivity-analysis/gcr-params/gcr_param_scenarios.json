{
    "baseline": {
        "description": "No-op baseline — common-random-numbers reference for the SI. Empty patch: GCR is run at the default seed sequence so every scenario shares the same draws and tail noise cancels in the difference.",
        "world_patches": {}
    },

    "noise_check": {
        "description": "No-op null check. Run at an offset --seed (e.g. 53) so its draws differ from the baseline; its SI vs baseline is then the pure Monte Carlo noise floor (anything below it is not a real signal).",
        "world_patches": {}
    },

    "r_inf_100x_up": {
        "description": "Background x-risk floor 100x higher  (ci_90: [1e-6, 5e-3])",
        "world_patches": {
            "r_inf": {
                "dist": "loguniform",
                "ci_90": [1e-6, 5e-3],
                "bounds": [1e-8, 1e-1]
            }
        }
    },

    "r_inf_100x_down": {
        "description": "Background x-risk floor 100x lower   (ci_90: [1e-10, 5e-7])",
        "world_patches": {
            "r_inf": {
                "dist": "loguniform",
                "ci_90": [1e-10, 5e-7],
                "bounds": [1e-12, 1e-5]
            }
        }
    },

    "no_cubic_growth": {
        "description": "Degenerate: no stellar expansion at all (p_cubic_growth = 0)",
        "world_patches": {
            "p_cubic_growth": {"dist": "constant", "value": 0}
        }
    },

    "s_10x_faster": {
        "description": "Stellar settlement speed ~10x faster, but capped at 0.2",
        "world_patches": {
            "s": {
                "dist": "loguniform",
                "ci_90": [4e-4, 0.1],
                "bounds": [1e-5, 0.2] 
            }
        }
    },

    "s_current_speeds": {
        "description": "Stellar settlement speed constant at 4e-5, the current speed of ships",
        "world_patches": {
            "s": {
                "dist": "constant",
                "value": 0.00004
            }
        }
    },

    "cause_fractions_equal": {
        "description": "Cause fractions uniform: bio=0.32, nuclear=0.32, AI=0.32",
        "world_patches": {
            "cause_fractions": {
                "dist": "dirichlet",
                "means": [0.32, 0.32, 0.32, 0.04],
